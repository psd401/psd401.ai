{
  "name": "psd401-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run lint && bun run format:check && bun run content:validate",
    "type-check": "tsc --noEmit",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:new": "tsx scripts/content-new.ts",
    "okf:build": "tsx scripts/okf-build.ts",
    "links:audit": "tsx scripts/links-audit.ts",
    "agent:audit": "tsx scripts/agent-audit.ts",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "field-notes:selftest": "tsx scripts/field-notes-selftest.ts",
    "field-notes:send": "tsx scripts/field-notes-send.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@tailwindcss/postcss": "^4.3.3",
    "gray-matter": "^4.0.3",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.11",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "prettier --write",
    "*.{json,md}": "prettier --write"
  }
}
